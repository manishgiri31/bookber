# =============================================================================
# BookBer Backend Environment Configuration
# =============================================================================
# This file contains all environment variables required for the BookBer backend.
# Copy this file to .env and fill in the actual values for your environment.
#
# Variables marked as [REQUIRED] must be set for the application to start.
# Variables marked as [OPTIONAL] have sensible defaults.

# =============================================================================
# App Configuration
# =============================================================================
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_NAME=BookBer
APP_URL=http://localhost:3000

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL="postgresql://postgres:root@localhost:5433/bookber?schema=public"
DATABASE_POOL_SIZE=10
DATABASE_SSL=false

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# JWT Configuration
# =============================================================================
JWT_ACCESS_SECRET=replace-with-long-random-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-long-random-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# =============================================================================
# Cookie Configuration
# =============================================================================
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ACCESS_TOKEN_COOKIE_NAME=bookber_at
REFRESH_TOKEN_COOKIE_NAME=bookber_rt

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGIN=http://localhost:3000

# =============================================================================
# Socket.io Configuration
# =============================================================================
SOCKET_CORS_ORIGIN=http://localhost:3000
SOCKET_NAMESPACE=/realtime
SOCKET_HEARTBEAT_MS=25000
SOCKET_STALE_MS=90000
SOCKET_STALE_SWEEP_MS=30000
SOCKET_EVENT_LOG_MAX=500
SOCKET_SYNC_DEFAULT_LIMIT=100

# =============================================================================
# Firebase/FCM Configuration
# =============================================================================
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
FCM_SERVER_KEY=

# =============================================================================
# Maps Configuration
# =============================================================================
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
GEOCODING_PROVIDER=openstreetmaps

# =============================================================================
# Uploads Configuration
# =============================================================================
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# =============================================================================
# AWS S3 Configuration
# =============================================================================
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# =============================================================================
# Rate Limiting Configuration
# =============================================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# Queue Engine Configuration
# =============================================================================
QUEUE_LOCK_TTL_MS=30000
QUEUE_ASSIGNMENT_TIMEOUT_MS=30000
QUEUE_RECOVERY_INTERVAL_MS=60000
QUEUE_MAX_SIZE=1000

# =============================================================================
# Wait Time Engine Configuration
# =============================================================================
WAIT_TIME_RECALC_INTERVAL_MS=300000
DEFAULT_SERVICE_DURATION=30
QUEUE_REBALANCE_THRESHOLD=5

# =============================================================================
# Recovery Workers Configuration
# =============================================================================
STALE_SERVICE_TIMEOUT_MINUTES=30
ORPHANED_CHAIR_TIMEOUT_MINUTES=60
REDIS_REPAIR_INTERVAL_MS=300000
DEAD_SOCKET_CLEANUP_INTERVAL_MS=300000
CHAIR_RECOVERY_INTERVAL_MS=300000

# =============================================================================
# OTP Configuration
# =============================================================================
OTP_TTL_SECONDS=300

# =============================================================================
# Password Configuration
# =============================================================================
PASSWORD_BCRYPT_ROUNDS=12

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=info
LOG_PRETTY_PRINT=true

# =============================================================================
# Monitoring Configuration
# =============================================================================
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
OTEL_ENABLED=false
OTEL_SERVICE_NAME=bookber-backend
OTEL_SERVICE_VERSION=1.0.0
OTEL_DEPLOYMENT_ENVIRONMENT=production
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# =============================================================================
# Scaling Configuration
# =============================================================================
SCALING_STRATEGY=horizontal

# =============================================================================
# Graceful Shutdown Configuration
# =============================================================================
SHUTDOWN_TIMEOUT_MS=30000
SHUTDOWN_DRAIN_TIMEOUT_MS=10000

# =============================================================================
# Redis Pool Configuration
# =============================================================================
REDIS_POOL_MIN_CONNECTIONS=5
REDIS_POOL_MAX_CONNECTIONS=50
REDIS_CONNECTION_TIMEOUT_MS=5000
REDIS_IDLE_TIMEOUT_MS=30000
REDIS_MAX_LIFETIME_MS=3600000
REDIS_HEALTH_CHECK_INTERVAL_MS=5000

# =============================================================================
# Redis Health Check Configuration
# =============================================================================
REDIS_MEMORY_CHECK_INTERVAL_MS=30000
REDIS_LATENCY_CHECK_INTERVAL_MS=5000
REDIS_REPLICATION_CHECK_INTERVAL_MS=10000
REDIS_CONNECTION_TIMEOUT_MS=3000
REDIS_MEMORY_THRESHOLD=80
REDIS_LATENCY_THRESHOLD_MS=1000
REDIS_REPLICATION_LAG_THRESHOLD_MS=30000

# =============================================================================
# Redis Failover Configuration
# =============================================================================
REDIS_FAILOVER_DETECTION_INTERVAL_MS=10000
REDIS_NODE_UNRESPONSIVE_THRESHOLD_MS=30000
REDIS_AUTO_RECONNECT=true
REDIS_RECONNECT_DELAY_MS=5000
REDIS_MAX_RECONNECT_ATTEMPTS=10

# =============================================================================
# Redis Cache Rebuild Configuration
# =============================================================================
REDIS_REBUILD_ON_HIT_RATE_THRESHOLD=0.8
REDIS_REBUILD_ON_MEMORY_PRESSURE=0.8
REDIS_REBUILD_ENABLE_AUTO=true
REDIS_REBUILD_INTERVAL_MS=300000
REDIS_REBUILD_BATCH_SIZE=100
REDIS_REBUILD_MAX_TIME_MS=60000

# =============================================================================
# Redis PubSub Optimizer Configuration
# =============================================================================
REDIS_PUBSUB_ENABLE_BATCHING=true
REDIS_PUBSUB_BATCH_SIZE=100
REDIS_PUBSUB_BATCH_TIMEOUT_MS=100
REDIS_PUBSUB_ENABLE_COMPRESSION=true
REDIS_PUBSUB_COMPRESSION_THRESHOLD=1024
REDIS_PUBSUB_ENABLE_DEDUPLICATION=true
REDIS_PUBSUB_DEDUPLICATION_TTL_MS=60000

# =============================================================================
# External Monitoring Services (Optional)
# =============================================================================
SENTRY_DSN=
DATADOG_API_KEY=
NEW_RELIC_LICENSE_KEY=
