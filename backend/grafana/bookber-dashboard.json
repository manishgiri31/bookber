        {
          "expr": "histogram_quantile(0.95, sum(rate(database_query_duration_bucket[5m])) by (le, model))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "title": "Chairs by Status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "targets": [
        {
          "expr": "active_chairs",
          "legendFormat": "{{shop_id}} {{status}}"
        }
      ]
    }
