generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String              @id @default(cuid())
  fullName            String
  email               String              @unique
  password            String
  phoneNumber         String?             @unique
  role                UserRole
  profileImage        String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  failedLoginAttempts Int                 @default(0)
  lockedUntil         DateTime?
  barber              Barber?
  bookings            Booking[]
  refreshTokens       RefreshToken[]
  reviews             Review[]
  ownedShops          Shop[]              @relation("ShopOwner")
  deviceTokens        DeviceToken[]
  rebookingReminders  RebookingReminder[]
  wallet              Wallet?
  loyaltyAccount      LoyaltyAccount?
  referralsGiven      Referral[]          @relation("ReferrerUser")
  referralsReceived   Referral[]          @relation("RefereeUser")
  couponRedemptions   CouponRedemption[]
  shopStaff           ShopStaff[]

  @@index([role])
  @@index([email])
  @@index([phoneNumber])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  Platform
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Shop {
  id                        String                    @id @default(cuid())
  name                      String
  description               String?
  address                   String
  city                      String
  state                     String
  country                   String
  latitude                  Float
  longitude                 Float
  openingTime               String?
  closingTime               String?
  isActive                  Boolean                   @default(true)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  bookBerReservedChairCount Int                       @default(0)
  addressLine2              String?
  email                     String?
  isAcceptingBookings       Boolean                   @default(true)
  isAcceptingWalkIns        Boolean                   @default(true)
  ownerId                   String
  phone                     String?
  postalCode                String?
  profileImage              String?
  slug                      String                    @unique
  timezone                  String                    @default("UTC")
  barbers                   Barber[]
  bookings                  Booking[]
  chairs                    Chair[]
  chairAllocations          ChairAllocation[]
  queueEntries              QueueEntry[]
  queueEvents               QueueEvent[]
  reviews                   Review[]
  services                  Service[]
  owner                     User                      @relation("ShopOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  operatingHours            ShopOperatingHour[]
  photos                    ShopPhoto[]
  staff                     ShopStaff[]

  @@index([city])
  @@index([latitude, longitude])
  @@index([ownerId])
  @@index([slug])
}

model ShopOperatingHour {
  id        String  @id @default(cuid())
  shopId    String
  dayOfWeek String
  openTime  String
  closeTime String
  isClosed  Boolean @default(false)
  shop      Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, dayOfWeek])
}

model ShopPhoto {
  id        String  @id @default(cuid())
  shopId    String
  url       String
  publicId  String?
  caption   String?
  sortOrder Int     @default(0)
  shop      Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model Barber {
  id                    String          @id @default(cuid())
  userId                String          @unique
  shopId                String
  bio                   String?
  experienceYears       Int?
  rating                Float           @default(0)
  isAvailable           Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  serviceSpeedFactor    Float           @default(1.0)
  averageServiceMinutes Int?
  checkInToken          String?         @unique
  onBreak               Boolean         @default(false)
  shop                  Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings              Booking[]
  queueEntries          QueueEntry[]
  barberServices        BarberService[]
  waitTimeMetrics       WaitTimeMetric[]

  @@index([shopId])
}

model BarberService {
  barberId  String
  serviceId String
  barber    Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@index([serviceId])
}

model Chair {
  id                 String            @id @default(cuid())
  shopId             String
  number             Int
  status             ChairStatus       @default(AVAILABLE)
  createdAt          DateTime          @default(now())
  reservedForBookBer Boolean           @default(false)
  activeServiceStart DateTime?
  activeServiceEnd   DateTime?
  updatedAt          DateTime          @updatedAt
  bookings           Booking[]
  shop               Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  chairAllocations   ChairAllocation[]
  queueEntries       QueueEntry[]

  @@unique([shopId, number])
  @@index([shopId, reservedForBookBer])
  @@index([activeServiceStart])
  @@index([shopId, status], map: "Chair_shop_available_idx", where: raw("(status = 'AVAILABLE'::\"ChairStatus\")"))
}

model Service {
  id                 String              @id @default(cuid())
  shopId             String
  name               String
  description        String?
  price              Float
  durationMinutes    Int
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  category           ServiceCategory     @default(HAIRCUT)
  rebookIntervalDays Int?
  bookings           Booking[]
  barberServices     BarberService[]
  shop               Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  rebookingReminders RebookingReminder[]

  @@index([shopId])
}

model Booking {
  id                 String            @id @default(cuid())
  userId             String
  shopId             String
  barberId           String?
  serviceId          String
  chairId            String?
  status             BookingStatus     @default(QUEUED)
  notes              String?
  scheduledStart     DateTime?
  travelMinutes      Int?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  arrivalWindowStart DateTime
  arrivalWindowEnd   DateTime
  walkIn             Boolean           @default(false)
  cancellationReason String?
  cancelledAt        DateTime?
  noShowAt           DateTime?
  barber             Barber?           @relation(fields: [barberId], references: [id])
  chair              Chair?            @relation(fields: [chairId], references: [id])
  service            Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  shop               Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  chairAllocations   ChairAllocation[]
  payment            Payment?
  queueEntry         QueueEntry?
  queueEvents        QueueEvent[]
  referenceImages    BookingReferenceImage[]

  @@index([userId])
  @@index([userId, status])
  @@index([shopId, status])
  @@index([barberId, status])
  @@index([status])
  @@index([scheduledStart])
}

model QueueEntry {
  id                    String      @id @default(cuid())
  shopId                String
  bookingId             String      @unique
  barberId              String?
  chairId               String?
  lane                  QueueLane
  position              Int
  queueStatus           QueueStatus @default(WAITING)
  estimatedWaitMinutes  Int         @default(0)
  estimatedServiceStart DateTime?
  version               Int         @default(0)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  barber                Barber?     @relation(fields: [barberId], references: [id])
  booking               Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  chair                 Chair?      @relation(fields: [chairId], references: [id])
  shop                  Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, lane, position])
  @@index([shopId, lane, position])
  @@index([shopId, position])
  @@index([barberId, queueStatus])
  @@index([bookingId])
}

model QueueEvent {
  id        String         @id @default(cuid())
  shopId    String
  bookingId String?
  type      QueueEventType
  payload   Json           @default("{}")
  createdAt DateTime       @default(now())
  booking   Booking?       @relation(fields: [bookingId], references: [id])
  shop      Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@index([bookingId])
}

model ChairAllocation {
  id                 String    @id @default(cuid())
  shopId             String
  chairId            String
  bookingId          String
  allocatedAt        DateTime  @default(now())
  releasedAt         DateTime?
  activeServiceStart DateTime?
  activeServiceEnd   DateTime?
  booking            Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  chair              Chair     @relation(fields: [chairId], references: [id], onDelete: Cascade)
  shop               Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([chairId, activeServiceStart])
  @@index([bookingId])
  @@index([shopId])
}

model Payment {
  id              String                  @id @default(cuid())
  bookingId       String                  @unique
  amount          Float
  method          PaymentMethod
  status          PaymentStatus           @default(PENDING)
  transactionId   String?
  createdAt       DateTime                @default(now())
  completedAt     DateTime?
  idempotencyKey  String?                 @unique
  refundReason    String?
  refundedAmount  Float                   @default(0)
  updatedAt       DateTime                @updatedAt
  booking         Booking                 @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  transactionLogs PaymentTransactionLog[]
  webhookEvents   WebhookEvent[]

  @@index([idempotencyKey])
  @@index([status])
  @@index([bookingId])
}

model PaymentTransactionLog {
  id              String        @id @default(cuid())
  paymentId       String
  action          String
  status          PaymentStatus
  gatewayResponse Json?
  errorMessage    String?
  metadata        Json?
  createdAt       DateTime      @default(now())
  payment         Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([action])
  @@index([createdAt])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  paymentId   String
  eventType   String
  payload     Json
  processedAt DateTime?
  receivedAt  DateTime  @default(now())
  payment     Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([eventType])
  @@index([processedAt])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  shopId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([userId])
}

model WaitTimeMetric {
  id              String          @id @default(cuid())
  shopId          String
  barberId        String
  category        ServiceCategory
  actualMinutes   Int
  expectedMinutes Int
  recordedAt      DateTime        @default(now())
  barber          Barber          @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([shopId, barberId, category])
  @@index([recordedAt])
}

model ShopAnalyticDaily {
  id                    String   @id @default(cuid())
  shopId                String
  date                  DateTime @db.Date
  totalBookings         Int      @default(0)
  totalWalkIns          Int      @default(0)
  completedBookings     Int      @default(0)
  cancelledBookings     Int      @default(0)
  noShows               Int      @default(0)
  avgWaitMinutes        Float    @default(0)
  avgServiceMinutes     Float    @default(0)
  totalRevenue          Float    @default(0)
  peakHour              Int?
  chairUtilizationPct   Float    @default(0)
  queueAbandonments     Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([shopId, date])
  @@index([shopId, date])
}

model RebookingReminder {
  id          String    @id @default(cuid())
  userId      String
  shopId      String
  serviceId   String
  lastVisitAt DateTime
  reminderAt  DateTime
  sentAt      DateTime?
  dismissed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([reminderAt])
  @@index([userId])
  @@index([shopId])
  @@index([sentAt], where: raw("(\"sentAt\" IS NULL)"))
}

model EventLog {
  id            String       @id @default(cuid())
  type          EventLogType
  shopId        String?
  bookingId     String?
  userId        String?
  chairId       String?
  correlationId String?
  payload       Json         @default("{}")
  createdAt     DateTime     @default(now())

  @@index([type, createdAt])
  @@index([shopId, createdAt])
  @@index([bookingId])
  @@index([correlationId])
}

enum UserRole {
  CLIENT
  BARBER
  ADMIN
  OWNER
  RECEPTION
}

enum BookingStatus {
  SCHEDULED
  QUEUED
  READY
  CALLED
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ChairStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  BLOCKED
}

enum QueueStatus {
  WAITING
  READY
  IN_SERVICE
  COMPLETED
  SKIPPED
  CALLED
  NO_SHOW
  CANCELLED
}

enum QueueLane {
  BOOKBER
  WALKIN
}

enum ServiceCategory {
  HAIRCUT
  BEARD
  COMBO
}

enum QueueEventType {
  ENQUEUED
  POSITION_CHANGED
  WAIT_RECALCULATED
  CALLED
  IN_SERVICE
  COMPLETED
  NO_SHOW
  CANCELLED
  CHAIR_ASSIGNED
  CHAIR_RELEASED
  DELAYED
  OVERRUN
  SCAN_CHECK_IN
  PROMOTED
}

enum EventLogType {
  BOOKING_CREATED
  BOOKING_SCHEDULED
  BOOKING_CANCELLED
  BOOKING_NO_SHOW
  QUEUE_JOINED
  QUEUE_LEFT
  CHAIR_ASSIGNED
  CHAIR_RELEASED
  PAYMENT_COMPLETED
  REVIEW_CREATED
  REBOOKING_REMINDER_SENT
  LEAVE_NOW_SENT
  RECEPTION_CHECKIN
}

enum PaymentMethod {
  CASH
  UPI
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum Platform {
  IOS
  ANDROID
  WEB
}

// ─── Wallet ───────────────────────────────────────────────────────────────────

model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  balance      Float               @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([userId])
}

model WalletTransaction {
  id        String                @id @default(cuid())
  walletId  String
  amount    Float
  type      WalletTransactionType
  reason    String
  refId     String?
  createdAt DateTime              @default(now())
  wallet    Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

// ─── Loyalty ──────────────────────────────────────────────────────────────────

model LoyaltyAccount {
  id           String               @id @default(cuid())
  userId       String               @unique
  points       Int                  @default(0)
  tier         LoyaltyTier          @default(BRONZE)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]

  @@index([userId])
}

model LoyaltyTransaction {
  id               String      @id @default(cuid())
  loyaltyAccountId String
  points           Int
  type             LoyaltyTransactionType
  reason           String
  refId            String?
  createdAt        DateTime    @default(now())
  account          LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)

  @@index([loyaltyAccountId])
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  EXPIRE
  ADJUSTMENT
}

// ─── Referral ─────────────────────────────────────────────────────────────────

model Referral {
  id            String         @id @default(cuid())
  referrerId    String
  refereeId     String?
  code          String         @unique
  status        ReferralStatus @default(PENDING)
  rewardGranted Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  referrer      User           @relation("ReferrerUser", fields: [referrerId], references: [id])
  referee       User?          @relation("RefereeUser", fields: [refereeId], references: [id])

  @@index([referrerId])
  @@index([code])
}

enum ReferralStatus {
  PENDING
  COMPLETED
  EXPIRED
}

// ─── Coupon ───────────────────────────────────────────────────────────────────

model Coupon {
  id              String             @id @default(cuid())
  code            String             @unique
  type            CouponType
  value           Float
  maxRedemptions  Int                @default(1)
  usedCount       Int                @default(0)
  minAmount       Float              @default(0)
  expiresAt       DateTime?
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  redemptions     CouponRedemption[]

  @@index([code])
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  bookingId String?
  discount  Float
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([couponId])
  @@index([userId])
}

// ─── Shop Staff ────────────────────────────────────────────────────────────────

model ShopStaff {
  id        String   @id @default(cuid())
  shopId    String
  userId    String
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([shopId])
  @@index([userId])
}

// ─── Booking Reference Images ─────────────────────────────────────────────────

model BookingReferenceImage {
  id        String   @id @default(cuid())
  bookingId String
  url       String
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

enum CouponType {
  PERCENT
  FLAT
}
