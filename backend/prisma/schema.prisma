generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  BARBER
  ADMIN
}

enum BookingStatus {
  QUEUED
  READY
  CALLED
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ChairStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  BLOCKED
}

enum QueueStatus {
  WAITING
  READY
  CALLED
  IN_SERVICE
  COMPLETED
  SKIPPED
  NO_SHOW
  CANCELLED
}

enum QueueLane {
  BOOKBER
  WALKIN
}

enum ServiceCategory {
  HAIRCUT
  BEARD
  COMBO
}

enum QueueEventType {
  ENQUEUED
  POSITION_CHANGED
  WAIT_RECALCULATED
  CALLED
  IN_SERVICE
  COMPLETED
  NO_SHOW
  CANCELLED
  CHAIR_ASSIGNED
  CHAIR_RELEASED
  DELAYED
  OVERRUN
}

enum EventLogType {
  BOOKING_CREATED
  BOOKING_CANCELLED
  QUEUE_JOINED
  QUEUE_LEFT
  CHAIR_ASSIGNED
  CHAIR_RELEASED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id                  String         @id @default(cuid())
  fullName            String
  email               String         @unique
  password            String
  phoneNumber         String?        @unique
  role                UserRole
  profileImage        String?
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  barber              Barber?
  ownedShops          Shop[]         @relation("ShopOwner")
  bookings            Booking[]
  reviews             Review[]
  refreshTokens       RefreshToken[]

  @@index([role])
  @@index([email])
  @@index([phoneNumber])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Shop {
  id                        String              @id @default(cuid())
  ownerId                   String
  name                      String
  slug                      String              @unique
  description               String?
  phone                     String?
  email                     String?
  address                   String
  addressLine2              String?
  city                      String
  state                     String
  country                   String
  postalCode                String?
  latitude                  Float
  longitude                 Float
  location                  Unsupported("geography(Point,4326)")?
  timezone                  String              @default("UTC")
  openingTime               String?
  closingTime               String?
  isActive                  Boolean             @default(true)
  isAcceptingBookings       Boolean             @default(true)
  isAcceptingWalkIns        Boolean             @default(true)
  bookBerReservedChairCount Int                 @default(0)
  profileImage              String?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  owner                     User                @relation("ShopOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  barbers                   Barber[]
  chairs                    Chair[]
  services                  Service[]
  bookings                  Booking[]
  reviews                   Review[]
  operatingHours            ShopOperatingHour[]
  photos                    ShopPhoto[]
  queueEntries              QueueEntry[]
  queueEvents               QueueEvent[]
  chairAllocations          ChairAllocation[]

  @@index([city])
  @@index([latitude, longitude])
  @@index([ownerId])
  @@index([slug])
  @@index([location], type: Gist)
}

model ShopOperatingHour {
  id        String  @id @default(cuid())
  shopId    String
  dayOfWeek String
  openTime  String
  closeTime String
  isClosed  Boolean @default(false)
  shop      Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, dayOfWeek])
}

model ShopPhoto {
  id        String  @id @default(cuid())
  shopId    String
  url       String
  publicId  String?
  caption   String?
  sortOrder Int     @default(0)
  shop      Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model Barber {
  id                    String       @id @default(cuid())
  userId                String       @unique
  shopId                String
  bio                   String?
  experienceYears       Int?
  rating                Float        @default(0)
  isAvailable           Boolean      @default(true)
  serviceSpeedFactor    Float        @default(1.0)
  averageServiceMinutes Int?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop                  Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bookings              Booking[]
  queueEntries          QueueEntry[]

  @@index([shopId])
}

model Chair {
  id                 String             @id @default(cuid())
  shopId             String
  number             Int
  status             ChairStatus        @default(AVAILABLE)
  reservedForBookBer Boolean            @default(false)
  activeServiceStart DateTime?
  activeServiceEnd   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  shop               Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bookings           Booking[]
  queueEntries       QueueEntry[]
  chairAllocations   ChairAllocation[]

  @@unique([shopId, number])
  @@index([shopId, reservedForBookBer])
  @@index([activeServiceStart])
}

model Service {
  id              String          @id @default(cuid())
  shopId          String
  name            String
  description     String?
  price           Float
  durationMinutes Int
  category        ServiceCategory @default(HAIRCUT)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  shop            Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bookings        Booking[]

  @@index([shopId])
}

model Booking {
  id                 String            @id @default(cuid())
  userId             String
  shopId             String
  barberId           String?
  serviceId          String
  chairId            String?
  status             BookingStatus     @default(QUEUED)
  arrivalWindowStart DateTime
  arrivalWindowEnd   DateTime
  walkIn             Boolean           @default(false)
  notes              String?
  cancellationReason String?
  cancelledAt        DateTime?
  noShowAt           DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop               Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  barber             Barber?           @relation(fields: [barberId], references: [id], onDelete: SetNull)
  service            Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  chair              Chair?            @relation(fields: [chairId], references: [id])
  payment            Payment?
  queueEntry         QueueEntry?
  queueEvents        QueueEvent[]
  chairAllocations   ChairAllocation[]

  @@index([shopId, status])
  @@index([barberId, status])
  @@index([status])
}

model QueueEntry {
  id                    String      @id @default(cuid())
  shopId                String
  bookingId             String      @unique
  barberId              String?
  chairId               String?
  lane                  QueueLane
  position              Int
  queueStatus           QueueStatus @default(WAITING)
  estimatedWaitMinutes  Int         @default(0)
  estimatedServiceStart DateTime?
  version               Int         @default(0)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  shop                  Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  booking               Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  barber                Barber?     @relation(fields: [barberId], references: [id], onDelete: SetNull)
  chair                 Chair?      @relation(fields: [chairId], references: [id])

  @@unique([shopId, lane, position])
  @@index([shopId, lane, position])
  @@index([shopId, position])
  @@index([barberId, queueStatus])
  @@index([bookingId])
}

model QueueEvent {
  id        String         @id @default(cuid())
  shopId    String
  bookingId String?
  type      QueueEventType
  payload   Json           @default("{}")
  createdAt DateTime       @default(now())
  shop      Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  booking   Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([bookingId])
}

model ChairAllocation {
  id                 String    @id @default(cuid())
  shopId             String
  chairId            String
  bookingId          String
  allocatedAt        DateTime  @default(now())
  releasedAt         DateTime?
  activeServiceStart DateTime?
  activeServiceEnd   DateTime?
  shop               Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  chair              Chair     @relation(fields: [chairId], references: [id], onDelete: Cascade)
  booking            Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([chairId, activeServiceStart])
  @@index([bookingId])
  @@index([shopId])
}

model Payment {
  id                 String                  @id @default(cuid())
  bookingId          String                  @unique
  amount             Float
  method             PaymentMethod
  status             PaymentStatus           @default(PENDING)
  transactionId      String?
  idempotencyKey     String?                 @unique
  refundedAmount     Float                   @default(0)
  refundReason       String?
  completedAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  booking            Booking                 @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  transactionLogs    PaymentTransactionLog[]
  webhookEvents      WebhookEvent[]

  @@index([idempotencyKey])
  @@index([status])
  @@index([bookingId])
}

model PaymentTransactionLog {
  id              String        @id @default(cuid())
  paymentId       String
  action          String
  status          PaymentStatus
  gatewayResponse Json?
  errorMessage    String?
  metadata        Json?
  createdAt       DateTime      @default(now())
  payment         Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([action])
  @@index([createdAt])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  paymentId   String
  eventType   String
  payload     Json
  processedAt DateTime?
  receivedAt  DateTime  @default(now())
  payment     Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([eventType])
  @@index([processedAt])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  shopId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model EventLog {
  id            String       @id @default(cuid())
  type          EventLogType
  shopId        String?
  bookingId     String?
  userId        String?
  chairId       String?
  correlationId String?
  payload       Json         @default("{}")
  createdAt     DateTime     @default(now())

  @@index([type, createdAt])
  @@index([shopId, createdAt])
  @@index([bookingId])
  @@index([correlationId])
}
